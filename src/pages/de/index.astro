---
import PageLayout from "@/layouts/PageLayout.astro";
import Hero from "@/components/Hero.astro";
import Features from "@/components/Features.astro";
import HowItWorks from "@/components/HowItWorks.astro";
import ShowcaseGrid from "@/components/ShowcaseGrid.astro";
import PricingTable from "@/components/PricingTable.astro";
import CTABanner from "@/components/CTABanner.astro";
import { getShowcases } from "@/lib/supabase";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

const lang: Lang = "de";
const t = useTranslations(lang);

const showcases = await getShowcases(lang);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "LDR – Lichtplanung & Nachtvisualisierung",
  description:
    "KI-gestützte Plattform, die Tagesfotos in professionelle Nachtvisualisierungen für die Lichtplanung verwandelt.",
  url: "https://www.ldr-design.com/de",
  applicationCategory: "DesignApplication",
  operatingSystem: "Web",
  inLanguage: "de",
  offers: [
    { "@type": "Offer", price: "0", priceCurrency: "USD", name: "Free" },
    { "@type": "Offer", price: "9", priceCurrency: "USD", name: "Mini" },
    { "@type": "Offer", price: "59", priceCurrency: "USD", name: "Small" },
    { "@type": "Offer", price: "129", priceCurrency: "USD", name: "Standard" },
    { "@type": "Offer", price: "299", priceCurrency: "USD", name: "Large" },
    { "@type": "Offer", price: "99", priceCurrency: "USD", name: "Pro" },
    { "@type": "Offer", price: "249", priceCurrency: "USD", name: "Max" },
  ],
};
---

<PageLayout
  title={t("meta.home.title")}
  description={t("meta.home.desc")}
  jsonLd={jsonLd}
  lang={lang}
>
  <Hero showcase={showcases[0]} lang={lang} />
  <Features lang={lang} />
  <HowItWorks lang={lang} />
  <ShowcaseGrid showcases={showcases} lang={lang} />
  <PricingTable lang={lang} />
  <CTABanner lang={lang} />
</PageLayout>
