---
/**
 * 应用场景索引页。卡片顺序与文案来自 i18n/useCases.ts + ui.ts，
 * 各语言共用同一份结构 —— 其他语言的同名文件只有 `lang` 一行不同。
 */
import PageLayout from "@/layouts/PageLayout.astro";
import CTABanner from "@/components/CTABanner.astro";
import type { Lang } from "@/i18n/ui";
import { useTranslations, getLocalizedPath } from "@/i18n/utils";
import { useCaseSlugs, useCaseUiKeys } from "@/i18n/useCases";

const lang: Lang = "tr";
const t = useTranslations(lang);

const useCases = useCaseSlugs.map((slug) => ({
  slug,
  title: t(useCaseUiKeys[slug].title),
  description: t(useCaseUiKeys[slug].desc),
  keywords: t(useCaseUiKeys[slug].keywords),
  href: getLocalizedPath(`/use-cases/${slug}`, lang),
}));

const origin = Astro.site ?? Astro.url.origin;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t("meta.useCases.title"),
  description: t("meta.useCases.desc"),
  url: new URL(getLocalizedPath("/use-cases", lang), origin).href,
  inLanguage: lang,
  hasPart: useCases.map((uc) => ({
    "@type": "WebPage",
    name: uc.title,
    url: new URL(uc.href, origin).href,
  })),
};
---

<PageLayout
  title={t("meta.useCases.title")}
  description={t("meta.useCases.desc")}
  jsonLd={jsonLd}
  lang={lang}
>
  <section class="max-w-4xl mx-auto px-4 pt-20 pb-12 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-[hsl(var(--foreground))] leading-tight">
      {t("useCases.heading")}
    </h1>
    <p class="mt-6 text-lg text-[hsl(var(--muted-foreground))] leading-relaxed">
      {t("useCases.subtitle")}
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-4 pb-20">
    <div class="grid md:grid-cols-2 gap-6">
      {useCases.map((uc) => (
        <a
          href={uc.href}
          class="group block rounded-2xl border border-[hsl(var(--border))] p-8 hover:border-[hsl(var(--primary))] transition-colors"
        >
          <h2 class="text-2xl font-bold text-[hsl(var(--foreground))] mb-3 hyphens-auto break-words">
            {uc.title}
          </h2>
          <p class="text-sm text-[hsl(var(--muted-foreground))] leading-relaxed mb-4">
            {uc.description}
          </p>
          <p class="text-xs text-[hsl(var(--muted-foreground))] mb-6">
            {uc.keywords}
          </p>
          <span class="text-sm text-[hsl(var(--primary))] group-hover:underline">
            {t("useCases.learnMore")}
          </span>
        </a>
      ))}
    </div>
  </section>

  <CTABanner lang={lang} />
</PageLayout>
