---
import { getCollection, render } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, description, pubDate, author, image } = post.data;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  author: {
    "@type": "Organization",
    name: "LDR Team",
  },
  publisher: {
    "@type": "Organization",
    name: "LDR - Lighting Design Rendering",
    url: "https://www.ldr-design.com",
  },
  ...(image ? { image: image.url } : {}),
};
---

<PageLayout
  title={`${title} — LDR Blog`}
  description={description}
  ogImage={image?.url}
  jsonLd={jsonLd}
>
  {/* 44rem 而不是 3xl(48rem)：配 prose-lg 的 18px 字号，英文约 74 字符/行、
      中文约 37 字/行，都落在舒适区。48rem + 16px 时英文每行逼近 95 字符，
      眼睛回到行首容易串行。 */}
  <article class="max-w-[44rem] mx-auto px-4 pt-20 pb-24">
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-sm text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))] transition-colors mb-10"
    >
      &larr; Back to Blog
    </a>

    {/* 标题在封面图之前：封面是 16:9，放在最上面会把 h1 顶到首屏之外，
        读者要先滚动才知道这篇讲什么 */}
    <header class="mb-10">
      {/* text-balance：不加的话「…Without Writing a / Prompt」会把最后一个词
          单独甩到第二行 */}
      <h1 class="text-balance text-3xl sm:text-4xl font-bold text-[hsl(var(--foreground))] leading-tight">
        {title}
      </h1>
      <div
        class="mt-4 flex items-center gap-4 text-sm text-[hsl(var(--muted-foreground))]"
      >
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span aria-hidden="true">&bull;</span>
        <span>{author}</span>
      </div>
    </header>

    {/* 封面与正文里的 figure 用同一组撑宽参数（见 tailwind.config.ts），
        否则封面比正文配图还窄，一眼就看出两套规则 */}
    {
      image && (
        <div class="blog-bleed aspect-video overflow-hidden rounded-xl border border-[hsl(var(--border))] mb-12">
          <img
            src={image.url}
            alt={image.alt}
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    {/* 具体排版规则见 tailwind.config.ts 的 theme.extend.typography ——
        中英两套路由页共用，避免改一处漏另一处 */}
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    <footer class="mt-16 pt-8 border-t border-[hsl(var(--border))]">
      <a
        href="/blog"
        class="text-sm text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))] transition-colors"
      >
        &larr; Back to Blog
      </a>
    </footer>
  </article>
</PageLayout>
