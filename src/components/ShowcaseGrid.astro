---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { localCategory, localPrompt, showcaseAlt } from "../i18n/showcase";
import { toThumbUrl } from "../lib/supabase";

interface Showcase {
  id: string;
  prompt: string;
  prompt_zh?: string;
  category: string;
  day_image_url: string;
  night_image_url: string;
}

interface Props {
  showcases?: Showcase[];
  lang?: Lang;
}

const { showcases = [], lang = "en" } = Astro.props;
const t = useTranslations(lang);
const hasItems = showcases.length > 0;
---

<section id="showcase" class="py-20 px-4">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-bold text-center text-[hsl(var(--foreground))]">
      {t("showcase.heading")}
    </h2>

    <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        hasItems ? (
          showcases.map((item) => {
            const cat = localCategory(item.category, lang);
            return (
              <div class="surface-card bg-[hsl(var(--card))] border border-[hsl(var(--border))] rounded-2xl overflow-hidden">
                <div class="aspect-[4/3] relative">
                  {/* 缩略图（1200px/q75）而非原图：原图是 4-5K，此处只显示 366px 宽。
                      onerror 先清 onerror 再回退原图，否则原图也失败会无限循环。
                      JSON.stringify 生成合法 JS 字符串字面量，避免 URL 特殊字符破坏语法。 */}
                  <img
                    src={toThumbUrl(item.night_image_url)}
                    onerror={`this.onerror=null;this.src=${JSON.stringify(item.night_image_url)}`}
                    alt={showcaseAlt(item, lang)}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                  {cat && (
                    <span class="absolute top-3 start-3 text-xs bg-[hsl(var(--background)/0.9)] text-[hsl(var(--foreground))] px-2 py-1 rounded-full">
                      {cat}
                    </span>
                  )}
                </div>
                <div class="p-4">
                  <p class="text-sm text-[hsl(var(--muted-foreground))] line-clamp-2">
                    {localPrompt(item, lang)}
                  </p>
                </div>
              </div>
            );
          })
        ) : (
          <div class="md:col-span-2 lg:col-span-3 surface-card bg-[hsl(var(--card))] border border-[hsl(var(--border))] rounded-2xl overflow-hidden">
            <div class="aspect-[4/3] relative flex items-center justify-center bg-[hsl(var(--muted)/0.4)]">
              <span class="text-[hsl(var(--muted-foreground))] text-sm">
                {t("showcase.empty")}
              </span>
            </div>
            <div class="p-4">
              <p class="text-sm text-[hsl(var(--muted-foreground))] line-clamp-2">
                {t("showcase.emptyDesc")}
              </p>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
