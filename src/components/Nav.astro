---
import type { Lang } from "../i18n/ui";
import {
  useTranslations,
  getLocalizedPath,
  getOtherLangs,
  stripLangPrefix,
  hasBlog,
} from "../i18n/utils";
import { routeExistsIn } from "../i18n/routes";
import { languages } from "../i18n/ui";
import { appLink } from "../lib/appUrl";

interface Props {
  lang?: Lang;
  /** 本页真实存在的语言版本；动态路由页必须传。见 PageLayout.astro 的说明。 */
  availableLangs?: Lang[];
}

const { lang = "en", availableLangs } = Astro.props;
const t = useTranslations(lang);

const navLinks = [
  { label: t("nav.useCases"), href: getLocalizedPath("/use-cases", lang) },
  { label: t("nav.pricing"), href: getLocalizedPath("/pricing", lang) },
  // 博客只在建了 src/pages/<lang>/blog/ 的语言里出现
  ...(hasBlog(lang)
    ? [{ label: t("nav.blog"), href: getLocalizedPath("/blog", lang) }]
    : []),
];

/**
 * 语言切换。并非每个页面都有全部语言版本（博客只有 en/zh，法律页只有 en），
 * 直接换前缀会切到 404。
 *
 * 这里与 hreflang 采取不同策略，因为两者的目标不同：
 *   hreflang 只能声明真实存在的页面（见 Head.astro），
 *   而语言菜单如果把缺失的语言直接藏掉，用户在法律页会发现切换器忽然少了几项。
 * 所以菜单始终列出全部语言，本页没有对应版本时退回该语言首页 —— 降级但不 404。
 *
 * 判据与 hreflang 同源：页面传了 availableLangs 就以它为准（博客文章逐篇不同，
 * 路由级推导会把只有 en/zh 的旧文章误判成有日语版，点了就 404）；
 * 静态页没传，退回 routes.ts 的路由级推导。
 */
const currentPath = stripLangPrefix(Astro.url.pathname);
const existsIn = (l: Lang) =>
  availableLangs ? availableLangs.includes(l) : routeExistsIn(currentPath, l);

const langOptions = getOtherLangs(lang).map((l) => ({
  code: l,
  label: languages[l],
  // 同名页面在各语言下 slug 一致，所以存在时整条路径换前缀即可
  href: existsIn(l) ? getLocalizedPath(currentPath, l) : getLocalizedPath("/", l),
}));
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-background/80 border-b border-border/50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a
      href={getLocalizedPath("/", lang)}
      class="flex items-center gap-2.5 text-xl font-bold text-foreground hover:text-primary transition-colors"
      aria-label="LDR"
    >
      <img src="/logo-mark.svg?v=20260715" alt="" width="32" height="32" class="h-8 w-8 shrink-0" />
      <span>LDR</span>
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm text-muted-foreground hover:text-foreground transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA + lang switch + mobile toggle -->
    <div class="flex items-center gap-3">
      <!-- Language switcher：用 <details> 而不是自建下拉，无 JS 也能展开，
           <summary> 自带按钮语义与键盘支持（Enter/Space） -->
      <details class="relative" id="lang-switcher">
        <summary
          class="flex cursor-pointer list-none items-center gap-1 rounded border border-border/50 px-2 py-1 text-xs text-muted-foreground transition-colors hover:border-border hover:text-foreground"
          aria-label="Language"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="h-3.5 w-3.5 shrink-0"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18" />
          </svg>
          {/* 窄屏只留地球图标：德语的 CTA（"Kostenlos testen"）比中英文长得多，
              375px 下语言名 + CTA 会挤到按钮换行、导航条变形 */}
          <span class="hidden sm:inline">{languages[lang]}</span>
        </summary>
        <ul
          class="absolute right-0 top-full z-50 mt-2 min-w-[8rem] overflow-hidden rounded-lg border border-border bg-background py-1 shadow-lg"
        >
          {langOptions.map((opt) => (
            <li>
              <a
                href={opt.href}
                hreflang={opt.code}
                lang={opt.code}
                class="block px-3 py-2 text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
              >
                {opt.label}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <a
        href={appLink("/", lang, "nav")}
        target="_blank"
        rel="noopener noreferrer"
        class="whitespace-nowrap bg-primary text-primary-foreground rounded-lg px-4 py-2 text-sm font-medium hover:opacity-90 transition-opacity"
      >
        {t("nav.tryFree")}
      </a>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden flex flex-col gap-1.5 p-1"
        aria-label={t("nav.toggleMenu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-5 h-0.5 bg-foreground transition-all" id="hamburger-top"></span>
        <span class="block w-5 h-0.5 bg-foreground transition-all" id="hamburger-mid"></span>
        <span class="block w-5 h-0.5 bg-foreground transition-all" id="hamburger-bot"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-border/50 bg-background/95 backdrop-blur-xl"
  >
    <ul class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-4">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="block text-sm text-muted-foreground hover:text-foreground transition-colors py-1"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  /* Safari 仍然画自己的三角标记，list-style:none 对它无效 */
  #lang-switcher > summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden", isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });

  // 语言下拉：点击别处 / 按 Esc 关闭。<details> 原生不做这件事。
  const langSwitcher = document.getElementById("lang-switcher") as HTMLDetailsElement | null;

  if (langSwitcher) {
    document.addEventListener("click", (e) => {
      if (langSwitcher.open && !langSwitcher.contains(e.target as Node)) {
        langSwitcher.open = false;
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && langSwitcher.open) {
        langSwitcher.open = false;
        langSwitcher.querySelector("summary")?.focus();
      }
    });
  }
</script>
