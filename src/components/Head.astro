---
import { defaultLang, type Lang } from "../i18n/ui";
import {
  getLocalizedPath,
  useTranslations,
  stripLangPrefix,
  ogLocale,
} from "../i18n/utils";
import { getLangsForRoute } from "../i18n/routes";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: object;
  lang?: Lang;
}

const {
  title,
  description,
  ogImage = "/og-image-v1.png",
  canonicalUrl,
  jsonLd,
  lang = "en",
} = Astro.props;

const t = useTranslations(lang);
const canonical = canonicalUrl ?? Astro.url.href;
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url.origin).href;
// 仅默认站点 og 图声明精确尺寸/类型；blog 文章封面图尺寸未知，硬声明会误导社交平台裁剪
const isDefaultOgImage = ogImage === "/og-image-v1.png";

/**
 * hreflang。只声明**确实存在**的语言版本 —— 给不存在的 URL 发 alternate
 * 会让 Google 抓到 404 并作废整组互链声明。
 *
 * 哪些语言存在由 i18n/routes.ts 从 src/pages 的实际文件推导：博客只有 en/zh，
 * 法律页只有 en，其余页面五语齐全。这里不做任何路径特判 ——
 * 特判过一次（只判了 /blog），结果漏掉法律页，导致它们声明了 4 个 404 的 alternate。
 */
const origin = Astro.site ?? Astro.url.origin;
const pathWithoutLang = stripLangPrefix(Astro.url.pathname);
const availableLangs = getLangsForRoute(pathWithoutLang);

// 当前页自己必须在结果里。不满足说明路由匹配逻辑没覆盖这种路径形态，
// 此时生成的 hreflang 一定是错的 —— 与其静默上线，不如让构建失败。
if (!availableLangs.includes(lang)) {
  throw new Error(
    `[i18n] 路由 ${pathWithoutLang} 未被识别为存在 ${lang} 版本（识别到：${availableLangs.join(", ") || "无"}）。` +
      `请检查 src/i18n/routes.ts 的动态路由匹配。`
  );
}

/**
 * 站点以目录形式构建（/de/pricing/index.html），canonical 因此带尾斜杠。
 * hreflang 指向的 URL 必须与目标页自己的 canonical **逐字符一致**，
 * 否则 Google 会认为互链声明对不上而整组忽略 —— 所以这里补回尾斜杠。
 */
function localizedHref(lang: Lang): string {
  const path = getLocalizedPath(pathWithoutLang, lang);
  return new URL(path === "/" ? path : `${path}/`, origin).href;
}

const alternates = availableLangs
  .map((l) => ({
    // zh 用 zh-Hans 而非 zh-CN：按脚本而非地区声明，简体中文使用者
    // 不论在新加坡还是马来西亚都能命中
    hreflang: l === "zh" ? "zh-Hans" : l,
    href: localizedHref(l),
  }));

const defaultUrl = localizedHref(defaultLang);
---

<title>{title} | LDR</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- hreflang -->
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}
<link rel="alternate" hreflang="x-default" href={defaultUrl} />

<!-- Open Graph -->
<meta property="og:title" content={`${title} | LDR`} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
{isDefaultOgImage && <meta property="og:image:type" content="image/png" />}
{isDefaultOgImage && <meta property="og:image:width" content="1200" />}
{isDefaultOgImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={`${title} | LDR`} />
<meta property="og:site_name" content={t("og.siteName")} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={ogLocale(lang)} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} | LDR`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={`${title} | LDR`} />

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
