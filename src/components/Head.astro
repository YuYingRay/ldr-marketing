---
import type { Lang } from "../i18n/ui";
import { getLocalizedPath, useTranslations } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: object;
  lang?: Lang;
}

const {
  title,
  description,
  ogImage = "/og-image-v1.png",
  canonicalUrl,
  jsonLd,
  lang = "en",
} = Astro.props;

const t = useTranslations(lang);
const canonical = canonicalUrl ?? Astro.url.href;
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url.origin).href;
// 仅默认站点 og 图声明精确尺寸/类型；blog 文章封面图尺寸未知，硬声明会误导社交平台裁剪
const isDefaultOgImage = ogImage === "/og-image-v1.png";

const pathWithoutLang = Astro.url.pathname.replace(/^\/zh/, "") || "/";
const enUrl = new URL(pathWithoutLang, Astro.site ?? Astro.url.origin).href;
const zhUrl = new URL(getLocalizedPath(pathWithoutLang, "zh"), Astro.site ?? Astro.url.origin).href;
---

<title>{title} | LDR</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- hreflang -->
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="zh" href={zhUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />

<!-- Open Graph -->
<meta property="og:title" content={`${title} | LDR`} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
{isDefaultOgImage && <meta property="og:image:type" content="image/png" />}
{isDefaultOgImage && <meta property="og:image:width" content="1200" />}
{isDefaultOgImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={`${title} | LDR`} />
<meta property="og:site_name" content={t("og.siteName")} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} | LDR`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={`${title} | LDR`} />

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
